<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>dev.j7126.combat_tracker</id>

    <name>Combat Tracker</name>
    <summary>A simple combat tracker app for ttrpg games</summary>
    <url type="homepage">https://github.com/j7126/combat-tracker</url>
    <url type="bugtracker">https://github.com/j7126/combat-tracker/issues</url>
    <url type="vcs-browser">https://github.com/j7126/combat-tracker</url>

    <metadata_license>MIT</metadata_license>
    <project_license>AGPL-3.0-or-later</project_license>

    <developer id="dev.j7126">
        <name>Jefferey Neuffer</name>
    </developer>

    <categories>
        <category>Game</category>
    </categories>

    <supports>
        <control>pointing</control>
        <control>keyboard</control>
        <control>touch</control>
    </supports>

    <description>
        <p>
            A simple combat tracker app for ttrpg games, with a few useful features
        </p>
        <ul>
            <li>Sort by initiative</li>
            <li>Track turn and round number</li>
            <li>Track damage - including who dealt how much damage to each enemy</li>
            <li>Custom columns</li>
        </ul>
    </description>

    <branding>
        <color type="primary" scheme_preference="light">#4c9643</color>
        <color type="primary" scheme_preference="dark">#35682f</color>
    </branding>

    <content_rating type="oars-1.1" />

